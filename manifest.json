{
  "schemaVersion": 1,
  "id": "liambryant.todo",
  "name": "Super T",
  "version": "1.1.0",
  "author": "laiambryant",
  "description": "A minimal, keyboard-driven Markdown task manager for Omarchy",
  "kinds": [
    "overlay",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "Todo.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Super T",
    "description": "Your open tasks, one click away",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
